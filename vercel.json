{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
 "buildCommand": "sh script/vercel-build.sh",
  "outputDirectory": "dist/public",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index", "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"] },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 7,14,21,28 * *"
    }
  ]
}
